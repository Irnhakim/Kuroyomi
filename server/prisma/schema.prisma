// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Manga {
  id                    Int       @id @default(autoincrement())
  url                   String
  title                 String
  status                Int       @default(0)
  author                String?
  artist                String?
  description           String?
  genre                 String?
  thumbnailUrl          String?
  thumbnailUrlLastFetched DateTime?
  inLibrary             Boolean   @default(false)
  inLibraryAt           DateTime?
  sourceId              String
  realUrl               String?
  initialized           Boolean   @default(false)
  lastFetchedAt         DateTime?
  chaptersLastFetchedAt DateTime?
  updateStrategy        String    @default("ALWAYS_UPDATE")
  lastModifiedAt        DateTime  @default(now()) @updatedAt
  createdAt             DateTime  @default(now())

  chapters    Chapter[]
  categories  CategoryManga[]
  history     ReadingHistory[]
  downloads   Download[]

  @@unique([url, sourceId])
}

model Chapter {
  id             Int       @id @default(autoincrement())
  url            String
  name           String
  chapterNumber  Float     @default(-1)
  dateUpload     DateTime?
  scanlator      String?
  isRead         Boolean   @default(false)
  isBookmarked   Boolean   @default(false)
  lastPageRead   Int       @default(0)
  lastReadAt     DateTime?
  isDownloaded   Boolean   @default(false)
  pageCount      Int       @default(-1)
  sourceOrder    Int       @default(0)
  realUrl        String?
  fetchedAt      DateTime  @default(now())
  lastModifiedAt DateTime  @default(now()) @updatedAt

  mangaId Int
  manga   Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  history  ReadingHistory[]
  download Download?

  @@unique([url, mangaId])
}

model Category {
  id      Int    @id @default(autoincrement())
  name    String @unique
  order   Int    @default(0)
  default Boolean @default(false)

  mangas CategoryManga[]
}

model CategoryManga {
  categoryId Int
  mangaId    Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  manga    Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@id([categoryId, mangaId])
}

model Extension {
  id          Int      @id @default(autoincrement())
  pkgName     String   @unique
  name        String
  lang        String   @default("all")
  versionName String   @default("1.0")
  versionCode Int      @default(1)
  iconUrl     String?
  apkName     String?
  repoUrl     String?
  isInstalled Boolean  @default(false)
  isObsolete  Boolean  @default(false)
  isNsfw      Boolean  @default(false)
  hasUpdate   Boolean  @default(false)
  installedAt DateTime?
  createdAt   DateTime @default(now())
}

model Source {
  id        String   @id
  name      String
  lang      String   @default("all")
  iconUrl   String?
  pkgName   String?
  isNsfw    Boolean  @default(false)
  baseUrl   String?
  createdAt DateTime @default(now())
}

model Download {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING")
  progress  Float    @default(0)
  error     String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapterId Int     @unique
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  mangaId Int
  manga   Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)
}

model ReadingHistory {
  id        Int      @id @default(autoincrement())
  page      Int      @default(0)
  readAt    DateTime @default(now())

  mangaId Int
  manga   Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model ServerConfig {
  key   String @id
  value String
}
